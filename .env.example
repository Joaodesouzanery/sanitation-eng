# Supabase Configuration
# Get these from https://app.supabase.com/project/_/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Backend API URL (Railway/Render)
VITE_RAILWAY_API_URL=https://your-api.railway.app

# Backend Environment Variables (for api/)
# These should be set on Railway/Render, not Vercel
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
ALLOWED_ORIGINS=http://localhost:5173,https://hydronetwork.vercel.app
