# =============================================================================
# HydroNetwork Security-Focused .gitignore
# =============================================================================

# =============================================================================
# SECURITY-CRITICAL FILES - NEVER COMMIT
# =============================================================================

# Environment and secrets
.env
.env.*
.env.local
.env.development
.env.production
.env.staging
*.env

# API keys and credentials
secrets/
credentials/
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.jks
*.keystore
.credentials
.secrets
api_keys.json
secrets.json
credentials.json
service_account*.json
google-credentials*.json
firebase*.json

# AWS credentials
.aws/
aws_credentials
.boto

# SSH keys
id_rsa*
id_ed25519*
id_ecdsa*
*.ppk

# JWT secrets
jwt_secret*
signing_key*

# Database credentials and files
*.sqlite
*.sqlite3
*.db
database_credentials*
db_password*

# Session files
session/
sessions/
.session

# =============================================================================
# PYTHON
# =============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Translations
*.mo
*.pot

# Django stuff:
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Flask stuff:
instance/
.webassets-cache

# Scrapy stuff:
.scrapy

# Sphinx documentation
docs/_build/

# PyBuilder
.pybuilder/
target/

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
.python-version

# PEP 582
__pypackages__/

# Celery stuff
celerybeat-schedule
celerybeat.pid

# SageMath parsed files
*.sage.py

# Environments
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# pytype static type analyzer
.pytype/

# Cython debug symbols
cython_debug/

# =============================================================================
# IDE AND EDITOR
# =============================================================================

# VSCode
.vscode/
*.code-workspace

# JetBrains IDEs
.idea/
*.iml
*.ipr
*.iws

# Vim
*.swp
*.swo
*~
.netrwhist

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*

# Sublime Text
*.sublime-workspace
*.sublime-project

# =============================================================================
# OS FILES
# =============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# =============================================================================
# LOGS AND TEMP FILES
# =============================================================================

# Log files
*.log
logs/
log/

# Temporary files
*.tmp
*.temp
*.bak
*.backup
tmp/
temp/

# Cache
.cache/
cache/

# =============================================================================
# PROJECT SPECIFIC
# =============================================================================

# Build artifacts
hydronetwork.zip
*.gpkg
output/
exports/

# Uploaded files (user data)
uploads/
upload/
imported/

# Generated reports
reports/
*.pdf
*.xlsx

# GIS data files (may contain sensitive location data)
data/
gis_data/
*.shp
*.dbf
*.shx
*.prj

# =============================================================================
# DOCKER
# =============================================================================

.docker/
docker-compose.override.yml

# =============================================================================
# NODE (if using frontend build tools)
# =============================================================================

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
package-lock.json
yarn.lock

# =============================================================================
# SECURITY SCAN RESULTS
# =============================================================================

# These may contain vulnerability information
.bandit/
.safety/
security_report*.json
vulnerability_scan*.xml
